NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# AI 답장 생성. 둘 중 하나만 있으면 됨 (Groq 우선, 없으면 Gemini 폴백).
# Groq: 카드 없이 무료, 지역 제한 없음 (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
# Gemini: 일부 지역은 무료 티어 limit:0 → 결제 필요 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

PUSH_API_SECRET=replace-with-a-long-random-secret
